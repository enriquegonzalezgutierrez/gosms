//kage:unit pixels
package main

// Iluminacion a partir del mapa de altura del pack HD.
//
// El atlas de color guarda albedo plano; este pase reconstruye la normal con el
// gradiente de altura y aplica luz direccional, especular y oclusion en las
// grietas. Como la altura existe dentro de cada pieza, el volumen es interior y
// no solo de contorno. El mapa de altura llega a la resolucion de destino, asi
// que un paso de 1 px es un pixel real de pantalla.

var Light vec2 // direccion de la luz en pantalla (x derecha, y abajo)
var Ambient float
var Diffuse float
var Specular float
var Gloss float
var Rim float
var Slope float     // cuanto inclina una unidad de altura la normal
var Occlusion float // oscurecimiento de las grietas

func heightAt(p vec2) float {
	limit := imageSrc1Size() - vec2(0.001)
	return imageSrc1At(clamp(p, vec2(0.0), limit)).r
}

func Fragment(dstPos vec4, src0Pos vec2, color vec4) vec4 {
	c := imageSrc0At(src0Pos)
	if c.a < 0.002 {
		return c
	}

	hl := heightAt(src0Pos - vec2(1.5, 0.0))
	hr := heightAt(src0Pos + vec2(1.5, 0.0))
	hu := heightAt(src0Pos - vec2(0.0, 1.5))
	hd := heightAt(src0Pos + vec2(0.0, 1.5))

	gx := hr - hl
	gy := hd - hu
	n := normalize(vec3(-gx*Slope, -gy*Slope, 1.0))

	l := normalize(vec3(Light, 1.24))
	halfway := normalize(l + vec3(0.0, 0.0, 1.0))

	diff := max(dot(n, l), 0.0)
	spec := pow(max(dot(n, halfway), 0.0), Gloss) * Specular
	rim := pow(1.0-clamp(n.z, 0.0, 1.0), 3.0) * Rim

	// La referencia es la superficie plana: una zona sin relieve conserva su
	// color exacto (el cielo del VDP no tiene altura y no debe oscurecerse).
	flat := l.z
	shade := Ambient + Diffuse*(diff-flat)
	shade -= clamp((abs(gx)+abs(gy))*Occlusion, 0.0, 0.45)

	// El color del atlas esta en sRGB. Multiplicar ahi aplasta las sombras
	// hasta el negro; elevar el factor a 1/2.2 equivale a iluminar en lineal.
	shade = pow(max(shade, 0.0), 1.0/1.6)

	rgb := c.rgb*shade + (spec+rim)*c.a
	return vec4(clamp(rgb, vec3(0.0), vec3(c.a)), c.a)
}
