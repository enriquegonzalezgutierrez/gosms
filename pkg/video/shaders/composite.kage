//kage:unit pixels
package main

var Bloom float
var Saturation float
var Contrast float
var Gamma float
var Brightness float

func Fragment(dstPos vec4, src0Pos vec2, color vec4) vec4 {
	base := imageSrc0At(src0Pos)
	bloom := imageSrc1AtFromSrc0Pos(src0Pos)

	// Both images are the same size for DrawRectShader, so the bloom buffer is
	// already stretched to the target resolution by the caller.
	rgb := base.rgb + bloom.rgb*Bloom

	luma := dot(rgb, vec3(0.299, 0.587, 0.114))
	rgb = mix(vec3(luma), rgb, Saturation)
	rgb = (rgb-vec3(0.5))*Contrast + vec3(0.5)
	rgb = rgb*Brightness

	// Gamma correction. A gamma lower than 1.0 lifts shadows; higher values
	// deepen them. Keep the result valid for premultiplied alpha.
	rgb = pow(max(rgb, vec3(0.0)), vec3(1.0/max(Gamma, 0.01)))
	rgb = clamp(rgb, vec3(0.0), vec3(base.a))

	return vec4(rgb, base.a)
}
