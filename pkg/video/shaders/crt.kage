//kage:unit pixels
package main

var Scanline float
var Mask float
var Vignette float
var Curvature float
var Lines float

func Fragment(dstPos vec4, src0Pos vec2, color vec4) vec4 {
	origin := imageSrc0Origin()
	size := imageSrc0Size()
	uv := (src0Pos - origin) / size

	// Mild barrel distortion. The inverse mapping keeps the sampled coordinate
	// inside the source image; outside the tube is black.
	cc := uv*2.0 - vec2(1.0)
	r2 := dot(cc, cc)
	cc *= 1.0 + Curvature*r2
	uv = cc*0.5 + vec2(0.5)
	if uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0 {
		return vec4(0.0, 0.0, 0.0, 1.0)
	}

	srcPos := uv*size + origin
	clr := imageSrc0At(srcPos)

	// Scanlines follow the original 192 visible lines, not the output pixels.
	line := uv.y*max(Lines, 1.0)
	beam := 0.5 + 0.5*sin(line*6.28318530718)
	scan := 1.0 - Scanline*(1.0-beam)

	// Aperture-grille style mask, very subtle by default.
	mask := vec3(1.0)
	if Mask > 0.0 {
		x := floor(uv.x*size.x)
		if mod(x, 3.0) < 1.0 {
			mask = vec3(1.0-Mask, 1.0, 1.0-Mask)
		} else if mod(x, 3.0) < 2.0 {
			mask = vec3(1.0, 1.0-Mask, 1.0)
		} else {
			mask = vec3(1.0, 1.0, 1.0-Mask)
		}
	}

	// Vignette centred on the tube.
	vig := 1.0 - Vignette*r2*0.35
	clr.rgb = clr.rgb * scan * mask * vig
	clr.rgb = clamp(clr.rgb, vec3(0.0), vec3(clr.a))
	return clr
}
